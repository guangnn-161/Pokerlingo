# Required for the web application
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pokerlingo
AUTH_SECRET=generate-a-long-random-secret
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth (enable either or both)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic-link login (optional locally, required to enable email sign-in)
AUTH_RESEND_KEY=
EMAIL_FROM=Pokerlingo <onboarding@resend.dev>

# Optional: shared Redis/Upstash rate limiter for production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional observability
SENTRY_DSN=